function(nr_check_arithmetic_flags)
  set(NVCC_PREPEND_FLAGS "$ENV{NVCC_PREPEND_FLAGS}")
  set(NVCC_APPEND_FLAGS "$ENV{NVCC_APPEND_FLAGS}")
  set(CUDACXX "$ENV{CUDACXX}")
  set(CXX "$ENV{CXX}")
  set(variables CMAKE_CUDA_FLAGS CMAKE_CXX_FLAGS CMAKE_CUDA_COMPILER_ARG1
    CMAKE_CXX_COMPILER_ARG1 NVCC_PREPEND_FLAGS NVCC_APPEND_FLAGS CUDACXX CXX)
  foreach(config DEBUG RELEASE RELWITHDEBINFO MINSIZEREL ${CMAKE_CONFIGURATION_TYPES} ${CMAKE_BUILD_TYPE})
    string(TOUPPER "${config}" config)
    list(APPEND variables CMAKE_CUDA_FLAGS_${config} CMAKE_CXX_FLAGS_${config})
  endforeach()
  foreach(variable IN LISTS variables)
    separate_arguments(arguments UNIX_COMMAND "${${variable}}")
    set(previous "")
    foreach(argument IN LISTS arguments)
      set(payload "")
      if(argument MATCHES "^(--compiler-options|-Xcompiler)=(.*)$")
        set(payload "${CMAKE_MATCH_2}")
      elseif(previous MATCHES "^(--compiler-options|-Xcompiler)$")
        set(payload "${argument}")
      endif()
      if(NOT payload STREQUAL "")
        string(REPLACE "," ";" forwarded "${payload}")
        foreach(option IN LISTS forwarded)
          if(option MATCHES "^@")
            message(FATAL_ERROR "${variable}: unsafe flags may be hidden in response files")
          endif()
          if(option MATCHES "^(-Ofast|-ffast-math|/fp:fast)$")
            message(FATAL_ERROR "${variable}: unsafe flags alter the compatibility arithmetic")
          endif()
        endforeach()
      endif()
      if(argument MATCHES "^(-optf|--options-file)(=|$)|^@")
        message(FATAL_ERROR "${variable}: unsafe flags may be hidden in options/response files")
      endif()
      if(argument MATCHES "^(-ccbin|--compiler-bindir)(=|$)")
        message(FATAL_ERROR "${variable}: select the host compiler with CMAKE_CUDA_HOST_COMPILER")
      endif()
      if(argument MATCHES "^(--?use_fast_math|-Ofast|-ffast-math|/fp:fast)$" OR
         argument MATCHES "^--?(ftz=true|prec-(div|sqrt)=false)$" OR
         (previous MATCHES "^--?ftz$" AND argument STREQUAL "true") OR
         (previous MATCHES "^--?prec-(div|sqrt)$" AND argument STREQUAL "false"))
        message(FATAL_ERROR "${variable}: unsafe flags alter the compatibility arithmetic")
      endif()
      set(previous "${argument}")
    endforeach()
  endforeach()
endfunction()
